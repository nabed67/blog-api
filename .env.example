NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/blog

# Comma-separated origin allowlist (wildcards are rejected)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Access and refresh token secrets must be at least 32 characters
JWT_SECRET=change-me-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-token-secret-min-32-chars

REDIS_URL=redis://localhost:6379

S3_BUCKET=blog-media
S3_REGION=us-east-1
S3_KEY_ID=your-s3-access-key-id
S3_SECRET=your-s3-secret-access-key
