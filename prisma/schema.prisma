generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  password    String
  displayName String?
  avatar      String?
  bio         String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
